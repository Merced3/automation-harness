# Copy this file to .env and supply deployment-specific values locally.
# Never commit .env.

# Stable identity for this deployed runtime node.
AUTOMATION_HARNESS_NODE_ID=

# Directory for runtime state (database, lock, status file).
AUTOMATION_HARNESS_DATA_DIR=data

# Logging
AUTOMATION_HARNESS_LOG_LEVEL=INFO
AUTOMATION_HARNESS_LOG_JSON=1

# Applications add their own settings in their own repositories.
