# Copy this file to .env and supply deployment-specific values locally.
# Never commit .env.
# Keep a real Postgres URL secret. Applications normally map their platform
# HARNESS_<APP>_DATABASE_URL value to HARNESS_DATABASE_URL in deployment config.

# Stable identity for this deployed runtime node.
AUTOMATION_HARNESS_NODE_ID=

# Optional Postgres operational store. Blank selects local SQLite.
# Install automation-harness[postgres] when this is set.
HARNESS_DATABASE_URL=
# Postgres instance lease TTL; heartbeats run at one-third of this interval.
HARNESS_LOCK_LEASE_SECONDS=30

# Directory for disposable status and, in SQLite mode, database/lock files.
AUTOMATION_HARNESS_DATA_DIR=data

# Logging
AUTOMATION_HARNESS_LOG_LEVEL=INFO
AUTOMATION_HARNESS_LOG_JSON=1

# Applications add their own settings in their own repositories.
